# ---------------------------------------------------------------------------
# collect-targeted-users - environment template
# Copy to .env and fill in your own values. NEVER commit the real .env
# (it is already listed in .gitignore).
#
# Everything here is OPTIONAL: the primary config is config.json at the repo
# root. Environment variables override config.json when both are set.
# ---------------------------------------------------------------------------

# --- Config file -----------------------------------------------------------
# Point at an alternative config.json (defaults to ./config.json).
CONFIG_PATH=

# --- Niche keywords (REQUIRED - set these or config.json search.keywords) ---
# Comma-separated. X_NICHE_KEYWORDS applies to both buckets; use the per-bucket
# vars to give A and B different keyword sets.
X_NICHE_KEYWORDS=
X_KEYWORDS_A=
X_KEYWORDS_B=
# Appended to every auto-generated keyword query.
X_QUERY_SUFFIX=-filter:replies
# Optional flat keyword list file (defaults to ./references/keywords.md).
X_KEYWORDS_FILE=

# --- Collection criteria (override config.json criteria.*) -----------------
X_TARGET=20
X_MAX_FOLLOWERS=40000
X_MIN_POSTS_30D=8
X_MIN_POSTS_30D_FLOOR=4
X_ACTIVITY_WINDOW_DAYS=30
X_MAX_LAST_POST_DAYS=7
X_CONCURRENCY=5
X_MAX_PROFILES=200
X_MAX_MINUTES=20
X_EXPAND_ROUNDS=3

# --- X session -------------------------------------------------------------
# The scanner loads the saved session DIRECTLY; it never attaches to a running
# Chrome. Two ways to supply it:
#   1. Save a session file with `node First/login.js --refresh` (default path
#      is ./auth.json), or
#   2. Provide the cookies here (useful for CI / headless servers).
X_AUTH_TOKEN=
X_AUTH_CT0=
# Optional custom location of the saved Playwright storageState file.
X_AUTH_FILE=./auth.json

# --- Google Sheet sink (the database) --------------------------------------
# Reading rows for de-duplication REQUIRES direct API mode, which needs the
# spreadsheet ID plus a local OAuth token with the spreadsheets scope.
# (You can set the same values in config.json -> export.*)
X_SHEET_ID=YOUR_SPREADSHEET_ID
X_SHEET_NAME=Targets
X_GOOGLE_TOKEN_PATH=~/.config/google-drive-mcp/tokens.json
# Optional local CSV mirror (the Sheet stays authoritative).
X_LOCAL_CSV=

# Optional: Apps Script Web App fallback (WRITE-ONLY - cannot be read back,
# so it cannot serve as the de-dup database).
X_SHEET_WEBAPP_URL=
GOOGLE_SHEETS_WEBAPP_URL=

# --- Browser / project layout (all optional) -------------------------------
# Where the shared Playwright helpers + session live. Defaults to this repo
# root; set only if you keep them elsewhere.
PROJ_ROOT=
TWITTER_PLAYWRIGHT_DIR=
# Chrome mode for the helper: auth (default for the collector), cdp, profile.
X_MODE=auth
X_CHROME_EXE=
X_PROFILE_DIR=
# Folder containing keywords.md (defaults to ./references).
X_SKILL_REFS=./references
